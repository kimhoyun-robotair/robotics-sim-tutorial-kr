<?xml version="1.0"?>
<robot name="learning_bot">
  <material name="blue"><color rgba="0.1 0.3 0.8 1"/></material>
  <material name="dark"><color rgba="0.08 0.08 0.08 1"/></material>
  <link name="base_link">
    <inertial><mass value="1"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.0015" iyz="0" izz="0.002"/></inertial>
    <visual><geometry><box size="0.12 0.09 0.04"/></geometry><material name="blue"/></visual>
    <collision><geometry><box size="0.12 0.09 0.04"/></geometry></collision>
  </link>
  <link name="left_wheel">
    <inertial><mass value="0.05"/><inertia ixx="0.000015" ixy="0" ixz="0" iyy="0.0000225" iyz="0" izz="0.000015"/></inertial>
    <visual><origin rpy="1.57079632679 0 0"/><geometry><cylinder radius="0.03" length="0.02"/></geometry><material name="dark"/></visual>
    <collision><origin rpy="1.57079632679 0 0"/><geometry><cylinder radius="0.03" length="0.02"/></geometry></collision>
  </link>
  <link name="right_wheel">
    <inertial><mass value="0.05"/><inertia ixx="0.000015" ixy="0" ixz="0" iyy="0.0000225" iyz="0" izz="0.000015"/></inertial>
    <visual><origin rpy="1.57079632679 0 0"/><geometry><cylinder radius="0.03" length="0.02"/></geometry><material name="dark"/></visual>
    <collision><origin rpy="1.57079632679 0 0"/><geometry><cylinder radius="0.03" length="0.02"/></geometry></collision>
  </link>
  <link name="caster">
    <inertial><mass value="0.01"/><inertia ixx="0.0000004" ixy="0" ixz="0" iyy="0.0000004" iyz="0" izz="0.0000004"/></inertial>
    <visual><geometry><sphere radius="0.01"/></geometry><material name="dark"/></visual>
    <collision><geometry><sphere radius="0.01"/></geometry></collision>
  </link>
  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/><child link="left_wheel"/>
    <origin xyz="0 0.05625 -0.03"/><axis xyz="0 1 0"/>
    <limit effort="2" velocity="30"/>
  </joint>
  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/><child link="right_wheel"/>
    <origin xyz="0 -0.05625 -0.03"/><axis xyz="0 1 0"/>
    <limit effort="2" velocity="30"/>
  </joint>
  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/><child link="caster"/><origin xyz="-0.05 0 -0.05"/>
  </joint>
</robot>
