#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
)
def Xform "World"
{
    def PhysicsScene "PhysicsScene" {}
    def Cube "Belt" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        double size = 2
        double3 xformOp:scale = (1.5, 0.3, 0.1)
        double3 xformOp:translate = (0, 0, 0.1)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        color3f[] primvars:displayColor = [(0.2, 0.4, 0.6)]
    }
    def Cube "Parcel" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        double size = 0.2
        float physics:mass = 0.5
        double3 xformOp:translate = (-1, 0, 0.6)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        color3f[] primvars:displayColor = [(0.7, 0.4, 0.1)]
    }
    def DistantLight "Light"
    {
        float inputs:intensity = 1500
    }
}
