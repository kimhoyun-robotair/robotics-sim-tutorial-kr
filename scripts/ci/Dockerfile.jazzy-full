# The plugin-only image remains small. This image also exercises rendered sensors and ROS nodes.
FROM ros:jazzy-ros-base
ENV DEBIAN_FRONTEND=noninteractive LANG=C.UTF-8 LC_ALL=C.UTF-8
# Jazzy vendor packages supply Harmonic and its development files from the ROS repository.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      build-essential git procps ca-certificates \
      ros-jazzy-gz-msgs-vendor ros-jazzy-gz-plugin-vendor \
      ros-jazzy-gz-sim-vendor ros-jazzy-gz-transport-vendor \
      python3-colcon-common-extensions python3-rosdep python3-pytest python3-yaml python3-jsonschema \
      ros-jazzy-ament-cmake-gtest ros-jazzy-ament-cmake-pytest \
      ros-jazzy-ros-gz ros-jazzy-xacro ros-jazzy-robot-state-publisher \
      ros-jazzy-joint-state-publisher-gui ros-jazzy-gz-ros2-control ros-jazzy-ros2-controllers \
      ros-jazzy-nav2-bringup ros-jazzy-slam-toolbox ros-jazzy-rviz2 \
      ros-jazzy-rviz-imu-plugin ros-jazzy-teleop-twist-keyboard \
      ros-jazzy-teleop-twist-joy ros-jazzy-joy ros-jazzy-tf-transformations \
      xvfb xauth xdotool imagemagick libgl1-mesa-dri libegl1-mesa-dev mesa-utils \
 && rm -rf /var/lib/apt/lists/*
ENV LIBGL_ALWAYS_SOFTWARE=1 QT_X11_NO_MITSHM=1
WORKDIR /source
