FROM ubuntu:24.04

ARG DEBIAN_FRONTEND=noninteractive
ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8
ENV ROS_DISTRO=jazzy

RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates ccache curl gnupg lsb-release locales software-properties-common \
 && curl -fsSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.key -o /usr/share/keyrings/ros-archive-keyring.gpg \
 && printf 'deb [arch=%s signed-by=/usr/share/keyrings/ros-archive-keyring.gpg] http://packages.ros.org/ros2/ubuntu %s main\n' "$(dpkg --print-architecture)" "$(. /etc/os-release && printf %s "$UBUNTU_CODENAME")" > /etc/apt/sources.list.d/ros2.list \
 && curl -fsSL https://packages.osrfoundation.org/gazebo.gpg -o /usr/share/keyrings/pkgs-osrf-archive-keyring.gpg \
 && printf 'deb [arch=%s signed-by=/usr/share/keyrings/pkgs-osrf-archive-keyring.gpg] http://packages.osrfoundation.org/gazebo/ubuntu-stable %s main\n' "$(dpkg --print-architecture)" "$(. /etc/os-release && printf %s "$UBUNTU_CODENAME")" > /etc/apt/sources.list.d/gazebo-stable.list \
 && apt-get update \
 && apt-get install -y --no-install-recommends build-essential gz-sim8-cli libgz-msgs10-dev libgz-plugin2-dev libgz-sim8-dev libgz-transport13-dev python3-colcon-common-extensions python3-pytest python3-rosdep python3-yaml ros-jazzy-ament-cmake ros-jazzy-ament-cmake-gtest ros-jazzy-ament-cmake-pytest ros-jazzy-geometry-msgs ros-jazzy-ros-base ros-jazzy-ros-gz-bridge \
 && rosdep init \
 && rosdep update --rosdistro jazzy \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /work
ENTRYPOINT ["/bin/bash", "/source/scripts/ci/run_ros_gazebo_ci.sh"]
