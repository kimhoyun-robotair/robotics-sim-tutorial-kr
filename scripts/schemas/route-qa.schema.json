{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gazebo-course.local/schemas/route-qa.schema.json",
  "title": "Rendered course route QA",
  "type": "object",
  "additionalProperties": false,
  "required": ["routes"],
  "properties": {
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/route" }
    }
  },
  "$defs": {
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "route", "visual_ids", "semantic_assertions", "alt_text", "caption",
        "source_sha", "light", "dark", "desktop", "mobile", "console_clean",
        "network_clean", "no_clipping"
      ],
      "properties": {
        "route": { "type": "string", "pattern": "^/.+/$" },
        "visual_ids": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "semantic_assertions": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "alt_text": { "type": "string", "minLength": 1 },
        "caption": { "type": "string", "minLength": 1 },
        "source_sha": { "type": "string", "pattern": "^[a-f0-9]{16,64}$" },
        "light": { "const": true },
        "dark": { "const": true },
        "desktop": { "const": true },
        "mobile": { "const": true },
        "console_clean": { "const": true },
        "network_clean": { "const": true },
        "no_clipping": { "const": true }
      }
    }
  }
}
