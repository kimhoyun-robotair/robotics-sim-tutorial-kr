{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "baseline_sha": {"pattern": "^[0-9a-f]{40}$", "type": "string"},
    "schema_version": {"const": 1},
    "source_sha": {"pattern": "^[0-9a-f]{40}$", "type": "string"},
    "tasks": {"items": {"type": "object"}, "type": "array"}
  },
  "required": ["schema_version", "baseline_sha", "source_sha", "tasks"],
  "type": "object"
}
