<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="gpu_lidar_2d"
               params="reference sensor_name topic frame_id update_rate:=10 samples:=360 min_angle:=-3.14159265359 max_angle:=3.14159265359 min_range:=0.12 max_range:=10.0 range_resolution:=0.01 noise_stddev:=0.01">
    <gazebo reference="${reference}">
      <sensor name="${sensor_name}" type="gpu_lidar">
        <!-- sensor 원점은 reference link 원점과 일치시켜 frame_id의 TF와 맞춘다. -->
        <pose>0 0 0 0 0 0</pose>
        <topic>${topic}</topic>
        <gz_frame_id>${frame_id}</gz_frame_id>
        <always_on>true</always_on>
        <update_rate>${update_rate}</update_rate>
        <visualize>true</visualize>
        <lidar>
          <scan>
            <horizontal>
              <samples>${samples}</samples>
              <resolution>1</resolution>
              <min_angle>${min_angle}</min_angle>
              <max_angle>${max_angle}</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>${min_range}</min>
            <max>${max_range}</max>
            <resolution>${range_resolution}</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>${noise_stddev}</stddev>
          </noise>
        </lidar>
      </sensor>
    </gazebo>
  </xacro:macro>

  <!-- vertical scan을 추가하면 같은 GPU LiDAR가 3차원 point cloud도 발행한다. -->
  <xacro:macro name="gpu_lidar_3d"
               params="reference sensor_name topic frame_id update_rate:=10 horizontal_samples:=640 vertical_samples:=16 min_vertical_angle:=-0.261799 max_vertical_angle:=0.261799 min_range:=0.20 max_range:=30.0">
    <gazebo reference="${reference}">
      <sensor name="${sensor_name}" type="gpu_lidar">
        <topic>${topic}</topic>
        <gz_frame_id>${frame_id}</gz_frame_id>
        <always_on>true</always_on>
        <update_rate>${update_rate}</update_rate>
        <visualize>true</visualize>
        <lidar>
          <scan>
            <horizontal>
              <samples>${horizontal_samples}</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159265359</min_angle>
              <max_angle>3.14159265359</max_angle>
            </horizontal>
            <vertical>
              <samples>${vertical_samples}</samples>
              <resolution>1</resolution>
              <min_angle>${min_vertical_angle}</min_angle>
              <max_angle>${max_vertical_angle}</max_angle>
            </vertical>
          </scan>
          <range>
            <min>${min_range}</min>
            <max>${max_range}</max>
            <resolution>0.01</resolution>
          </range>
          <noise><type>gaussian</type><mean>0.0</mean><stddev>0.01</stddev></noise>
        </lidar>
      </sensor>
    </gazebo>
  </xacro:macro>
</robot>
