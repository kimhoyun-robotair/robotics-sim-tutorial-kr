#!/usr/bin/env python3
from __future__ import annotations

import argparse
import importlib
import time
from collections.abc import Callable
from typing import cast

import rclpy
from geometry_msgs.msg import TransformStamped
from lifecycle_msgs.msg import Transition
from lifecycle_msgs.srv import ChangeState, GetState
from rclpy.client import Client
from rclpy.node import Node
from tf2_msgs.msg import TFMessage

reach_state = cast(
    Callable[..., bool],
    importlib.import_module("localization_transition").reach_state,
)


NAVIGATION_NODES = (
    "controller_server",
    "smoother_server",
    "planner_server",
    "behavior_server",
    "velocity_smoother",
    "collision_monitor",
    "bt_navigator",
)


class LifecycleBoundaryNode(Node):
    def __init__(self, call_timeout: float) -> None:
        super().__init__("tutorial_lifecycle_activator")
        self.call_timeout = call_timeout
        self.state_clients: dict[str, Client] = {}
        self.transition_clients: dict[str, Client] = {}
        self.map_to_odom_ready = False
        self.create_subscription(TFMessage, "/tf", self._observe_tf, 100)

    def _observe_tf(self, message: TFMessage) -> None:
        self.map_to_odom_ready = self.map_to_odom_ready or any(
            cast(TransformStamped, transform).header.frame_id.lstrip("/") == "map"
            and cast(TransformStamped, transform).child_frame_id.lstrip("/") == "odom"
            for transform in message.transforms
        )

    def _client(self, clients: dict[str, Client], service: str, service_type: type) -> Client:
        client = clients.get(service)
        if client is None:
            client = self.create_client(service_type, service)
            clients[service] = client
        return client

    def current_state(self, node_name: str) -> int | None:
        service = f"/{node_name}/get_state"
        client = self._client(self.state_clients, service, GetState)
        if not client.wait_for_service(timeout_sec=self.call_timeout):
            return None
        future = client.call_async(GetState.Request())
        rclpy.spin_until_future_complete(self, future, timeout_sec=self.call_timeout)
        response = future.result() if future.done() else None
        return response.current_state.id if response is not None else None

    def request_transition(self, node_name: str, transition_id: int) -> bool | None:
        service = f"/{node_name}/change_state"
        client = self._client(self.transition_clients, service, ChangeState)
        if not client.wait_for_service(timeout_sec=self.call_timeout):
            return None
        request = ChangeState.Request()
        request.transition.id = transition_id
        future = client.call_async(request)
        rclpy.spin_until_future_complete(self, future, timeout_sec=self.call_timeout)
        response = future.result() if future.done() else None
        return response.success if response is not None else None

    def idle(self, seconds: float) -> None:
        rclpy.spin_once(self, timeout_sec=seconds)


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--phase", choices=("startup", "deactivate"), default="startup")
    parser.add_argument("--deadline", type=float, default=55.0)
    parser.add_argument("--call-timeout", type=float, default=4.0)
    arguments = parser.parse_args()
    if arguments.deadline <= 0 or arguments.call_timeout <= 0:
        return 2

    rclpy.init()
    boundary = LifecycleBoundaryNode(arguments.call_timeout)
    deadline = time.monotonic() + arguments.deadline
    try:
        if arguments.phase == "deactivate":
            transitions = tuple(
                (
                    node_name,
                    Transition.TRANSITION_DEACTIVATE,
                    2,
                    "inactive [2]",
                )
                for node_name in reversed(NAVIGATION_NODES)
            )
        else:
            transitions = (
                ("map_server", Transition.TRANSITION_CONFIGURE, 2, "inactive [2]"),
                ("map_server", Transition.TRANSITION_ACTIVATE, 3, "active [3]"),
                ("amcl", Transition.TRANSITION_CONFIGURE, 2, "inactive [2]"),
                ("amcl", Transition.TRANSITION_ACTIVATE, 3, "active [3]"),
            )
        for node_name, transition_id, target_state, label in transitions:
            if not reach_state(
                boundary, node_name, transition_id, target_state, deadline
            ):
                print(f"Timed out transitioning {node_name} to {label}.")
                return 1
            print(f"{node_name}={label}")
        if arguments.phase == "deactivate":
            print("navigation=inactive")
            return 0
        while time.monotonic() < deadline and not boundary.map_to_odom_ready:
            boundary.idle(0.2)
        if not boundary.map_to_odom_ready:
            print("Timed out waiting for map->odom after localization activation.")
            return 1
        print("map_to_odom=ready")
        navigation_transitions = tuple(
            (
                node_name,
                Transition.TRANSITION_CONFIGURE,
                2,
                "inactive [2]",
            )
            for node_name in NAVIGATION_NODES
        ) + tuple(
            (node_name, Transition.TRANSITION_ACTIVATE, 3, "active [3]")
            for node_name in NAVIGATION_NODES
        )
        for node_name, transition_id, target_state, label in navigation_transitions:
            if not reach_state(
                boundary, node_name, transition_id, target_state, deadline
            ):
                print(f"Timed out transitioning {node_name} to {label}.")
                return 1
            print(f"{node_name}={label}")
        print("navigation=ready")
        return 0
    finally:
        boundary.destroy_node()
        rclpy.shutdown()


if __name__ == "__main__":
    raise SystemExit(main())
