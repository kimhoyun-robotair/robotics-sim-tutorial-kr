Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
    - Class: rviz_default_plugins/Map
      Name: Map
      Enabled: true
      Topic:
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        Value: /map
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
    - Class: rviz_default_plugins/LaserScan
      Name: 2D LiDAR
      Enabled: true
      Topic:
        Reliability Policy: Best Effort
        Value: /scan
    - Class: rviz_default_plugins/Odometry
      Name: Wheel Odometry
      Enabled: true
      Keep: 1000
      Topic:
        Reliability Policy: Best Effort
        Value: /odom
    - Class: rviz_default_plugins/Path
      Name: Wheel Odom Trajectory
      Enabled: true
      Line Style: Lines
      Line Width: 0.03
      Topic:
        Reliability Policy: Reliable
        Value: /wheel_odom_path
    - Class: rviz_default_plugins/PointCloud2
      Name: RGB-D PointCloud2
      Enabled: true
      Topic:
        Reliability Policy: Best Effort
        Value: /camera/points
    - Class: rviz_default_plugins/PointCloud2
      Name: 3D LiDAR PointCloud2
      Enabled: false
      Topic:
        Reliability Policy: Best Effort
        Value: /lidar_3d/points
    - Class: rviz_default_plugins/Camera
      Name: RGB Camera
      Enabled: true
      Topic:
        Reliability Policy: Best Effort
        Value: /camera/image
    - Class: rviz_default_plugins/Image
      Name: Mono Camera
      Enabled: false
      Topic:
        Reliability Policy: Best Effort
        Value: /mono/image
    - Class: rviz_default_plugins/Image
      Name: Stereo Left
      Enabled: false
      Topic:
        Reliability Policy: Best Effort
        Value: /stereo/left/image
    - Class: rviz_default_plugins/Image
      Name: Stereo Right
      Enabled: false
      Topic:
        Reliability Policy: Best Effort
        Value: /stereo/right/image
    - Class: rviz_default_plugins/Image
      Name: Fisheye Camera
      Enabled: false
      Topic:
        Reliability Policy: Best Effort
        Value: /fisheye/image
    - Class: rviz_imu_plugin/Imu
      Name: IMU
      Enabled: true
      Topic:
        Reliability Policy: Best Effort
        Value: /imu
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
    - Class: rviz_default_plugins/Path
      Name: Nav2 Plan
      Enabled: true
      Topic:
        Reliability Policy: Reliable
        Value: /plan
  Global Options:
    Fixed Frame: odom
  Name: root
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Invert Z Axis: false
      Scale: 60
      Target Frame: <Fixed Frame>
      X: 0.0
      Y: 0.0
Window Geometry:
  Height: 720
  Width: 1280
