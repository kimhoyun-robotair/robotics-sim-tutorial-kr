{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gazebo-sim-tutorial-kr.local/diagnostics-contract.schema.json",
  "title": "TutorialBotDiagnostics observable contract",
  "type": "object",
  "required": ["diagnostics"],
  "additionalProperties": false,
  "properties": {
    "diagnostics": {
      "type": "object",
      "required": ["plugin", "parameters", "states", "lifecycle", "future_behavior_tests"],
      "additionalProperties": false,
      "properties": {
        "plugin": {"type": "object"},
        "parameters": {"type": "object"},
        "states": {
          "type": "array",
          "prefixItems": [
            {"const": "WAITING_FOR_MODEL"},
            {"const": "READY"},
            {"const": "DISABLED"},
            {"const": "MODEL_REMOVED"},
            {"const": "INVALID_CONFIG"}
          ],
          "items": false
        },
        "lifecycle": {"type": "object"},
        "future_behavior_tests": {"type": "array", "items": {"type": "string"}, "minItems": 5}
      }
    }
  }
}
