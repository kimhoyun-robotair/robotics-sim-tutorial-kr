<?xml version="1.0" ?>
<sdf version="1.10">
  <world name="advanced_diagnostics">
    <gravity>0 0 0</gravity>
    <physics name="diagnostics_step" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="libTutorialBotDiagnosticsSystem.so"
            name="gz::sim::systems::TutorialBotDiagnostics">
      <model_name>tutorial_bot</model_name>
      <publish_period>0.1</publish_period>
    </plugin>
    <plugin filename="libTutorialBotDiagnosticsSystem.so"
            name="gz::sim::systems::TutorialBotDiagnostics">
      <model_name>lifecycle_bot</model_name>
      <distance_topic>/lifecycle_bot/diagnostics/distance</distance_topic>
      <status_topic>/lifecycle_bot/diagnostics/status</status_topic>
      <publish_period>0.1</publish_period>
    </plugin>

    <model name="tutorial_bot">
      <pose>0 0 0 0 0 0</pose>
      <link name="base_link">
        <inertial>
          <mass>1</mass>
          <inertia>
            <ixx>1</ixx><iyy>1</iyy><izz>1</izz>
          </inertia>
        </inertial>
      </link>
      <plugin filename="gz-sim-velocity-control-system"
              name="gz::sim::systems::VelocityControl"/>
    </model>
  </world>
</sdf>
