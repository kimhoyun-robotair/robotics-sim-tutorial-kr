<?xml version="1.0" ?>
<sdf version="1.10">
  <world name="sensor_test">
    <gravity>0 0 -9.80665</gravity>
    <scene><ambient>0.35 0.35 0.35 1</ambient></scene>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <light name="sun" type="directional">
      <pose>0 0 8 0 0 0</pose>
      <direction>-0.5 0.2 -1</direction>
      <diffuse>1 1 1 1</diffuse>
    </light>

    <model name="sensor_floor">
      <static>true</static>
      <pose>0 0 -0.05 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>20 20 0.1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>20 20 0.1</size></box></geometry>
        </visual>
      </link>
    </model>

    <model name="sensor_enclosure">
      <static>true</static>
      <link name="link">
        <collision name="west"><pose>-4 0 2 0 0 0</pose><geometry><box><size>0.1 8 4</size></box></geometry></collision>
        <collision name="east"><pose>4 0 2 0 0 0</pose><geometry><box><size>0.1 8 4</size></box></geometry></collision>
        <collision name="south"><pose>0 -4 2 0 0 0</pose><geometry><box><size>8 0.1 4</size></box></geometry></collision>
        <collision name="north"><pose>0 4 2 0 0 0</pose><geometry><box><size>8 0.1 4</size></box></geometry></collision>
        <visual name="west"><pose>-4 0 2 0 0 0</pose><geometry><box><size>0.1 8 4</size></box></geometry></visual>
        <visual name="east"><pose>4 0 2 0 0 0</pose><geometry><box><size>0.1 8 4</size></box></geometry></visual>
        <visual name="south"><pose>0 -4 2 0 0 0</pose><geometry><box><size>8 0.1 4</size></box></geometry></visual>
        <visual name="north"><pose>0 4 2 0 0 0</pose><geometry><box><size>8 0.1 4</size></box></geometry></visual>
      </link>
    </model>

    <!-- Camera, depth, 2D/3D LiDAR에서 함께 식별할 수 있는 표적이다. -->
    <model name="sensor_target">
      <static>true</static>
      <pose>2 0 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.4 1.0 0.8</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.4 1.0 0.8</size></box></geometry>
          <material>
            <ambient>0.75 0.08 0.05 1</ambient>
            <diffuse>0.9 0.12 0.08 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
