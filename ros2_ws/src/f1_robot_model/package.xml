<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>f1_robot_model</name>
  <version>0.0.0</version>
  <description>F1TENTH model and sensor exercises for ROS 2 Humble and Gazebo Classic 11.</description>
  <maintainer email="genis@todo.todo">genis</maintainer>
  <license>Apache-2.0 (repository additions); original model assets: see UPSTREAM.md</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <!-- Robot modeling in rviz and gazebo -->
  <depend>robot_state_publisher</depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>rviz_imu_plugin</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <depend>xacro</depend>
  <exec_depend>gazebo_plugins</exec_depend>
  <depend>gazebo_ros</depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>joy</exec_depend>
  <exec_depend>teleop_twist_joy</exec_depend>
  <exec_depend>velodyne_gazebo_plugins</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>nav2_amcl</exec_depend>
  <exec_depend>nav2_map_server</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend>
  <exec_depend>nav2_common</exec_depend>
  <exec_depend>nav2_rviz_plugins</exec_depend>
  <!-- Message depend -->
  <depend>ackermann_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>rclcpp</depend>



  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <!-- package://f1_robot_model/... becomes model://f1_robot_model/... in Gazebo. -->
    <gazebo_ros gazebo_model_path="${prefix}/.."/>
  </export>
</package>
