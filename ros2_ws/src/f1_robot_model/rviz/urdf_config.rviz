Panels:
- Class: rviz_common/Displays
  Name: Displays
- Class: rviz_common/Views
  Name: Views
Visualization Manager:
  Class: ''
  Global Options:
    Fixed Frame: odom
    Frame Rate: 30
    Background Color: 40; 44; 52
  Displays:
  - Class: rviz_default_plugins/Grid
    Name: Grid
    Enabled: true
    Plane Cell Count: 20
    Cell Size: 0.5
  - Class: rviz_default_plugins/RobotModel
    Name: RobotModel
    Enabled: true
    Description Source: Topic
    Description Topic:
      Value: /robot_description
      Durability Policy: Transient Local
      Reliability Policy: Reliable
      History Policy: Keep Last
      Depth: 1
  - Class: rviz_default_plugins/LaserScan
    Name: 2D LiDAR
    Enabled: true
    Topic:
      Value: /scan
      Reliability Policy: Best Effort
      Durability Policy: Volatile
      History Policy: Keep Last
      Depth: 5
    Style: Points
    Size (Pixels): 3
    Color Transformer: FlatColor
    Color: 255; 100; 70
    Decay Time: 0
  - Class: rviz_imu_plugin/Imu
    Enabled: true
    Name: IMU
    fixed_frame_orientation: true
    Topic:
      Depth: 10
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Value: /imu/data
    Acceleration properties:
      Acc. vector alpha: 1
      Acc. vector color: 255; 0; 0
      Acc. vector scale: 0.03
      Derotate acceleration: true
      Enable acceleration: true
    Box properties:
      Box alpha: 1
      Box color: 255; 255; 0
      Enable box: true
      x_scale: 0.12
      y_scale: 0.08
      z_scale: 0.04
    Axes properties:
      Axes scale: 0.12
      Enable axes: true
  - Class: rviz_default_plugins/PointCloud2
    Name: Depth points
    Enabled: false
    Topic:
      Value: /camera/points
      Reliability Policy: Best Effort
      Durability Policy: Volatile
      History Policy: Keep Last
      Depth: 5
    Style: Points
    Size (Pixels): 2
    Color Transformer: RGB8
    Decay Time: 0
  - Class: rviz_default_plugins/Image
    Name: RGB camera
    Enabled: false
    Topic:
      Value: /camera/image_raw
      Reliability Policy: Best Effort
      Durability Policy: Volatile
      History Policy: Keep Last
      Depth: 5
  - Class: rviz_default_plugins/PointCloud2
    Name: 3D LiDAR (optional)
    Enabled: false
    Topic:
      Value: /lidar_3d/points
      Reliability Policy: Best Effort
      Durability Policy: Volatile
      History Policy: Keep Last
      Depth: 5
    Style: Points
    Size (Pixels): 2
    Color Transformer: AxisColor
    Axis: Z
  - Class: rviz_default_plugins/TF
    Name: TF
    Enabled: false
    Show Axes: true
    Show Names: true
    Marker Scale: 0.2
  Tools:
  - Class: rviz_default_plugins/Interact
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/SetInitialPose
    Topic:
      Value: /initialpose
      Reliability Policy: Reliable
      Durability Policy: Volatile
      History Policy: Keep Last
      Depth: 5
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 4.0
      Pitch: 0.5
      Yaw: 3.9
      Focal Point:
        X: 0.7
        Y: 0.0
        Z: 0.3
      Target Frame: <Fixed Frame>
Window Geometry:
  Width: 1280
  Height: 800
  X: 0
  Y: 0
