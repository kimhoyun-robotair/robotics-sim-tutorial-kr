<?xml version="1.0"?>
<!-- Two-wheel differential-drive robot with a passive swivelling caster. -->
<robot name="diffbot" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:include filename="$(find gazebo_tutorial_description)/urdf/common.xacro"/>
  <xacro:include filename="$(find gazebo_tutorial_plugins)/urdf/ground_truth_path_plugin.gazebo.xacro"/>

  <!-- Dimensions are declared once and reused by geometry and plugins. -->
  <xacro:property name="base_length" value="0.45"/>
  <xacro:property name="base_width" value="0.32"/>
  <xacro:property name="base_height" value="0.12"/>
  <xacro:property name="base_mass" value="7.0"/>
  <xacro:property name="base_z" value="0.12"/>

  <xacro:property name="wheel_radius" value="0.09"/>
  <xacro:property name="wheel_width" value="0.04"/>
  <xacro:property name="wheel_mass" value="0.55"/>
  <xacro:property name="wheel_separation" value="0.36"/>
  <xacro:property name="wheel_x" value="0.075"/>
  <xacro:property name="wheel_z" value="${wheel_radius - base_z}"/>

  <xacro:property name="caster_radius" value="0.04"/>
  <xacro:property name="caster_width" value="0.025"/>
  <xacro:property name="caster_pivot_x" value="-0.17"/>
  <xacro:property name="caster_trail" value="0.035"/>

  <!-- base_footprint is the planar navigation frame located on the ground. -->
  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${base_z}" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
      <material name="tutorial_blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
    </collision>
    <xacro:box_inertial
      mass="${base_mass}"
      x="${base_length}"
      y="${base_width}"
      z="${base_height}"/>
  </link>

  <gazebo reference="base_link">
    <material>Gazebo/Blue</material>
    <mu1>0.7</mu1>
    <mu2>0.7</mu2>
    <kp>1000000.0</kp>
    <kd>10.0</kd>
  </gazebo>

  <!-- The two driven wheels. Positive rotation about +y moves the body +x. -->
  <xacro:simple_wheel
    name="left_wheel"
    parent="base_link"
    xyz="${wheel_x} ${wheel_separation / 2.0} ${wheel_z}"
    radius="${wheel_radius}"
    width="${wheel_width}"
    mass="${wheel_mass}"/>

  <xacro:simple_wheel
    name="right_wheel"
    parent="base_link"
    xyz="${wheel_x} ${-wheel_separation / 2.0} ${wheel_z}"
    radius="${wheel_radius}"
    width="${wheel_width}"
    mass="${wheel_mass}"/>

  <!--
    Passive caster: the first joint swivels about +z and the second rolls about
    +y. The wheel centre trails the swivel axis, so contact forces align it.
  -->
  <link name="caster_swivel_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.025" length="0.04"/>
      </geometry>
      <material name="tutorial_gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.025" length="0.04"/>
      </geometry>
    </collision>
    <xacro:cylinder_inertial mass="0.12" radius="0.025" length="0.04"/>
  </link>

  <joint name="caster_swivel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="caster_swivel_link"/>
    <origin xyz="${caster_pivot_x} 0 -0.05" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="2.0" velocity="20.0"/>
    <dynamics damping="0.08" friction="0.01"/>
  </joint>

  <link name="caster_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="${PI / 2.0} 0 0"/>
      <geometry>
        <cylinder radius="${caster_radius}" length="${caster_width}"/>
      </geometry>
      <material name="tutorial_dark"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="${PI / 2.0} 0 0"/>
      <geometry>
        <cylinder radius="${caster_radius}" length="${caster_width}"/>
      </geometry>
    </collision>
    <xacro:cylinder_inertial
      mass="0.14"
      radius="${caster_radius}"
      length="${caster_width}"
      origin_rpy="${PI / 2.0} 0 0"/>
  </link>

  <joint name="caster_wheel_joint" type="continuous">
    <parent link="caster_swivel_link"/>
    <child link="caster_wheel_link"/>
    <origin xyz="${-caster_trail} 0 -0.03" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="2.0" velocity="30.0"/>
    <dynamics damping="0.03" friction="0.0"/>
  </joint>

  <gazebo reference="caster_swivel_link">
    <material>Gazebo/Grey</material>
    <selfCollide>false</selfCollide>
  </gazebo>
  <gazebo reference="caster_wheel_link">
    <material>Gazebo/Black</material>
    <mu1>0.6</mu1>
    <mu2>0.6</mu2>
    <kp>1000000.0</kp>
    <kd>10.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>0.1</maxVel>
  </gazebo>

  <!-- ROS 2 Humble / Gazebo Classic 11 differential-drive model plugin. -->
  <gazebo>
    <plugin name="diffbot_diff_drive" filename="libgazebo_ros_diff_drive.so">
      <ros>
        <namespace>/</namespace>
        <remapping>cmd_vel:=cmd_vel</remapping>
        <remapping>odom:=odom</remapping>
      </ros>
      <update_rate>50.0</update_rate>

      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>${wheel_separation}</wheel_separation>
      <wheel_diameter>${2.0 * wheel_radius}</wheel_diameter>

      <max_wheel_torque>20.0</max_wheel_torque>
      <max_wheel_acceleration>5.0</max_wheel_acceleration>

      <!-- 0 selects wheel-encoder integration instead of world ground truth. -->
      <odometry_source>0</odometry_source>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <!-- robot_state_publisher owns base-to-wheel TF, avoiding duplicates. -->
      <publish_wheel_tf>false</publish_wheel_tf>
      <covariance_x>0.0001</covariance_x>
      <covariance_y>0.0001</covariance_y>
      <covariance_yaw>0.001</covariance_yaw>
    </plugin>

    <!-- Publish the actual Gazebo angles for every non-fixed joint. -->
    <plugin name="diffbot_joint_states" filename="libgazebo_ros_joint_state_publisher.so">
      <ros>
        <namespace>/</namespace>
        <remapping>joint_states:=joint_states</remapping>
      </ros>
      <update_rate>50.0</update_rate>
      <joint_name>left_wheel_joint</joint_name>
      <joint_name>right_wheel_joint</joint_name>
      <joint_name>caster_swivel_joint</joint_name>
      <joint_name>caster_wheel_joint</joint_name>
    </plugin>
  </gazebo>

  <!-- Custom tutorial plugin: Gazebo world pose for odometry comparison. -->
  <xacro:ground_truth_path_plugin topic="ground_truth_path" frame="world"/>
</robot>
