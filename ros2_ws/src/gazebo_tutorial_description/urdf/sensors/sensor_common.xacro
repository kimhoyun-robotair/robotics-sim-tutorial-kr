<?xml version="1.0"?>
<!-- Copyright 2026 gazebo-sim-tutorial-kr contributors (Apache-2.0) -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- 센서 모듈이 공통으로 사용하는 장착 링크와 optical frame을 정의한다. -->
  <xacro:macro
    name="sensor_mount_box"
    params="link_name parent xyz rpy:='0 0 0' size_x:=0.05 size_y:=0.05 size_z:=0.05 color:='sensor_gray' mass:=0.05">
    <link name="${link_name}">
      <visual>
        <geometry>
          <box size="${size_x} ${size_y} ${size_z}"/>
        </geometry>
        <material name="${color}"/>
      </visual>
      <!-- 센서 링크에도 양의 질량과 관성을 두어 Gazebo의 물리 경고를 피한다. -->
      <inertial>
        <mass value="${mass}"/>
        <inertia
          ixx="${mass * (size_y * size_y + size_z * size_z) / 12.0}"
          ixy="0.0"
          ixz="0.0"
          iyy="${mass * (size_x * size_x + size_z * size_z) / 12.0}"
          iyz="0.0"
          izz="${mass * (size_x * size_x + size_y * size_y) / 12.0}"/>
      </inertial>
    </link>

    <joint name="${link_name}_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="${link_name}"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
    </joint>
  </xacro:macro>

  <!-- REP-103 optical frame은 +Z 전방, +X 오른쪽, +Y 아래쪽을 사용한다. -->
  <xacro:macro name="sensor_optical_frame" params="frame_name parent">
    <link name="${frame_name}"/>
    <joint name="${frame_name}_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="${frame_name}"/>
      <origin xyz="0 0 0" rpy="${-pi / 2.0} 0 ${-pi / 2.0}"/>
    </joint>
  </xacro:macro>
</robot>
