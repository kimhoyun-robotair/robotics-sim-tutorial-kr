<?xml version="1.0"?>
<robot name="rover_diff" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:include filename="$(find gazebo_tutorial_description)/urdf/macros/rover_macros.xacro"/>

  <xacro:rover_base body_mass="12.0"/>

  <!-- skid-steer: 네 바퀴가 모두 base_link에 고정된 축을 중심으로 돈다. -->
  <xacro:fixed_axle_wheel
    prefix="front_left" parent="base_link"
    x="${rover_wheelbase / 2.0}" y="${rover_track_width / 2.0}" z="-0.08"/>
  <xacro:fixed_axle_wheel
    prefix="front_right" parent="base_link"
    x="${rover_wheelbase / 2.0}" y="-${rover_track_width / 2.0}" z="-0.08"/>
  <xacro:fixed_axle_wheel
    prefix="rear_left" parent="base_link"
    x="-${rover_wheelbase / 2.0}" y="${rover_track_width / 2.0}" z="-0.08"/>
  <xacro:fixed_axle_wheel
    prefix="rear_right" parent="base_link"
    x="-${rover_wheelbase / 2.0}" y="-${rover_track_width / 2.0}" z="-0.08"/>

  <gazebo>
    <plugin name="rover_diff_drive" filename="libgazebo_ros_diff_drive.so">
      <ros>
        <namespace>/</namespace>
        <remapping>cmd_vel:=cmd_vel</remapping>
        <remapping>odom:=odom</remapping>
      </ros>

      <!-- ROS 2용 플러그인은 wheel pair 수만큼 아래 태그를 반복해서 읽는다. -->
      <num_wheel_pairs>2</num_wheel_pairs>
      <left_joint>front_left_wheel_joint</left_joint>
      <right_joint>front_right_wheel_joint</right_joint>
      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>rear_right_wheel_joint</right_joint>
      <wheel_separation>${rover_track_width}</wheel_separation>
      <wheel_separation>${rover_track_width}</wheel_separation>
      <wheel_diameter>${2.0 * rover_wheel_radius}</wheel_diameter>
      <wheel_diameter>${2.0 * rover_wheel_radius}</wheel_diameter>

      <max_wheel_torque>20.0</max_wheel_torque>
      <max_wheel_acceleration>4.0</max_wheel_acceleration>
      <update_rate>100</update_rate>

      <!-- 0 = ENCODER. 바퀴 회전량을 적분한 wheel odometry를 사용한다. -->
      <odometry_source>0</odometry_source>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>false</publish_wheel_tf>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
      <covariance_x>0.001</covariance_x>
      <covariance_y>0.001</covariance_y>
      <covariance_yaw>0.01</covariance_yaw>
    </plugin>
  </gazebo>

  <gazebo>
    <plugin name="rover_diff_joint_states" filename="libgazebo_ros_joint_state_publisher.so">
      <ros>
        <namespace>/</namespace>
      </ros>
      <update_rate>50</update_rate>
      <joint_name>front_left_wheel_joint</joint_name>
      <joint_name>front_right_wheel_joint</joint_name>
      <joint_name>rear_left_wheel_joint</joint_name>
      <joint_name>rear_right_wheel_joint</joint_name>
    </plugin>
  </gazebo>
</robot>
