<?xml version="1.0"?>
<package format="3">
  <name>gazebo_tutorial_bringup</name>
  <version>0.1.0</version>
  <description>Reusable Gazebo Classic launch files and RViz presets for the tutorial robots.</description>
  <maintainer email="kimhoyun.robotair@gmail.com">kimhoyun-robotair</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>gazebo_ros</exec_depend>
  <exec_depend>gazebo_tutorial_description</exec_depend>
  <exec_depend>gazebo_tutorial_tools</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>rviz_imu_plugin</exec_depend>
  <exec_depend>teleop_twist_keyboard</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>xacro</exec_depend>

  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
