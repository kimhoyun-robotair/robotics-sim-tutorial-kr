<?xml version="1.0"?>
<sdf version="1.6">
  <world name="sensor_tutorial_world">
    <gravity>0 0 -9.80665</gravity>

    <physics name="ode_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000.0</real_time_update_rate>
    </physics>

    <scene>
      <ambient>0.45 0.45 0.45 1</ambient>
      <background>0.68 0.76 0.85 1</background>
      <shadows>true</shadows>
    </scene>

    <!-- 기본 지면과 조명을 파일 안에 두어 첫 실행에도 외부 모델을 받지 않는다. -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation><range>1000</range><constant>0.9</constant><linear>0.01</linear><quadratic>0.001</quadratic></attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- +X 방향 카메라와 LiDAR에서 즉시 보이는 색상/거리 기준물. -->
    <model name="red_near_box">
      <static>true</static>
      <pose>2.0 -0.9 0.45 0 0 0.25</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.65 0.65 0.9</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.65 0.65 0.9</size></box></geometry>
          <material>
            <ambient>0.8 0.05 0.05 1</ambient>
            <diffuse>0.9 0.08 0.08 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="green_mid_cylinder">
      <static>true</static>
      <pose>3.0 0.9 0.65 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.38</radius><length>1.3</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.38</radius><length>1.3</length></cylinder></geometry>
          <material>
            <ambient>0.05 0.65 0.10 1</ambient>
            <diffuse>0.08 0.85 0.14 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="blue_far_box">
      <static>true</static>
      <pose>4.5 -1.3 0.35 0 0 -0.2</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.0 0.45 0.7</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.0 0.45 0.7</size></box></geometry>
          <material>
            <ambient>0.03 0.15 0.75 1</ambient>
            <diffuse>0.05 0.25 0.95 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="front_wall">
      <static>true</static>
      <pose>6.0 0 1.0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.15 6.0 2.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.15 6.0 2.0</size></box></geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- 후방/측면 scan에도 서로 다른 range가 나타나도록 낮은 벽을 둔다. -->
    <model name="rear_wall">
      <static>true</static>
      <pose>-3.0 0 0.6 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.15 5.0 1.2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.15 5.0 1.2</size></box></geometry>
          <material>
            <ambient>0.75 0.6 0.1 1</ambient>
            <diffuse>0.9 0.75 0.15 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
