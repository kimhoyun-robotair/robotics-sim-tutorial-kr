<?xml version="1.0"?>
<!-- SI units. World fixation is authored in the Isaac Sim scene, not in URDF. -->
<robot name="one_joint_arm">
  <material name="base_gray"><color rgba="0.25 0.28 0.32 1"/></material>
  <material name="arm_orange"><color rgba="0.9 0.3 0.05 1"/></material>
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0.15" rpy="0 0 0"/>
      <mass value="4"/>
      <inertia ixx="0.06" ixy="0" ixz="0" iyy="0.06" iyz="0" izz="0.06"/>
    </inertial>
    <visual><origin xyz="0 0 0.15"/><geometry><box size="0.3 0.3 0.3"/></geometry><material name="base_gray"/></visual>
    <collision><origin xyz="0 0 0.15"/><geometry><box size="0.3 0.3 0.3"/></geometry></collision>
  </link>
  <link name="arm_link">
    <inertial>
      <origin xyz="0.35 0 0" rpy="0 0 0"/>
      <mass value="1"/>
      <inertia ixx="0.0010666667" ixy="0" ixz="0" iyy="0.0305333333" iyz="0" izz="0.0305333333"/>
    </inertial>
    <visual><origin xyz="0.35 0 0"/><geometry><box size="0.6 0.08 0.08"/></geometry><material name="arm_orange"/></visual>
    <collision><origin xyz="0.35 0 0"/><geometry><box size="0.6 0.08 0.08"/></geometry></collision>
  </link>
  <joint name="shoulder" type="revolute">
    <parent link="base_link"/><child link="arm_link"/>
    <origin xyz="0 0 0.35" rpy="0 0 0"/><axis xyz="0 0 1"/>
    <limit lower="-1.57079632679" upper="1.57079632679" effort="20" velocity="1"/>
    <dynamics damping="0.1" friction="0"/>
  </joint>
</robot>
